{
  "name": "memory-ferry",
  "version": "0.7.0-beta.1",
  "description": "Local-first, folder-synced long-term memory and reusable skills for AI agents.",
  "type": "module",
  "bin": {
    "memory-ferry": "dist/cli.js",
    "agent-vault": "dist/cli.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "build:exe:win": "npm run build && node scripts/build-windows-exe.mjs",
    "dev": "tsx src/cli.ts",
    "test": "node scripts/run-tests.mjs",
    "test:all": "npm run build && npm test",
    "prepack": "npm run test:all"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agent",
    "memory",
    "mcp",
    "skills",
    "local-first"
  ],
  "homepage": "https://github.com/iced7/memory-ferry#readme",
  "bugs": {
    "url": "https://github.com/iced7/memory-ferry/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iced7/memory-ferry.git"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@yao-pkg/pkg": "^6.22.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
