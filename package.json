{
  "name": "memory-ferry",
  "version": "1.1.0",
  "description": "Local-first, folder-synced long-term memory and reusable skills for AI agents.",
  "type": "module",
  "bin": {
    "memory-ferry": "dist/cli.js",
    "agent-vault": "dist/cli.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && node scripts/check-release-version.mjs && tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "build:exe:win": "npm run build && node scripts/build-windows-exe.mjs",
    "dev": "tsx src/cli.ts",
    "test": "node scripts/run-tests.mjs",
    "test:all": "npm run build && npm test",
    "test:stress": "node scripts/stress-embeddings.mjs",
    "test:encryption": "node scripts/smoke-encryption.mjs",
    "prepack": "npm run test:all"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agent",
    "memory",
    "mcp",
    "skills",
    "local-first"
  ],
  "homepage": "https://github.com/iced7/memory-ferry#readme",
  "bugs": {
    "url": "https://github.com/iced7/memory-ferry/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iced7/memory-ferry.git"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/proper-lockfile": "^4.1.4",
    "@yao-pkg/pkg": "^6.24.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
